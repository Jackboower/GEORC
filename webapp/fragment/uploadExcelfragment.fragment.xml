<core:FragmentDefinition xmlns="sap.m" xmlns:u="sap.ui.unified" xmlns:l="sap.ui.layout" xmlns:core="sap.ui.core" xmlns:f="sap.ui.layout.form">
    <Dialog title="{i18n>Upload}" id="ListDialog">
         <VBox id="vbox" class="sapUiSmallMargin">
                <u:FileUploader
                id="fileUploader"
                name="myFileUpload"
                uploadUrl="upload/"
                tooltip="Selecione seu arquivo Excel"
                fileType="xlsx,xls"
                placeholder="Escolha o arquivo..."
                style="Emphasized"
                change="onFileChange"/>
         </VBox>
        <beginButton>
            <Button id="upload" text="Upload" press="onSave" type="Emphasized" />
        </beginButton>
        <endButton>
            <Button id="close" text="Close" press="onClose" />
        </endButton>
    </Dialog>
</core:FragmentDefinition>